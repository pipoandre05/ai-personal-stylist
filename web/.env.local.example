# Copiar a .env.local y completar. Nunca versionar .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API (solo servidor)
ANTHROPIC_API_KEY=
STYLIST_MODEL=claude-opus-5-5
STYLIST_EFFORT=low
VISION_MODEL=claude-haiku-5-5

# mock = IA simulada determinista (sin clave, para desarrollo y tests) · live = Claude API
AI_MODE=mock

# Tope diario de mensajes de chat por persona (R-15)
CHAT_DAILY_LIMIT=60
