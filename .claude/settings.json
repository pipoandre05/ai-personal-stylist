{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-}/.claude/hooks/freno.sh\"; if [ ! -f \"$f\" ]; then r=$(git rev-parse --show-toplevel 2>/dev/null); f=\"$r/.claude/hooks/freno.sh\"; fi; if [ ! -f \"$f\" ]; then echo 'FRENO: no encuentro .claude/hooks/freno.sh; bloqueo por seguridad (falla cerrado).' >&2; exit 2; fi; bash \"$f\"; c=$?; [ \"$c\" -eq 0 ] && exit 0; exit 2",
            "timeout": 150
          }
        ]
      },
      {
        "matcher": "mcp__.*__(apply_migration|execute_sql|deploy_edge_function|merge_branch|reset_branch|rebase_branch|delete_branch|pause_project|restore_project|create_project|create_deployment|request_promote|request_rollback|deploy_to_vercel|redeploy)",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-}/.claude/hooks/freno.sh\"; if [ ! -f \"$f\" ]; then r=$(git rev-parse --show-toplevel 2>/dev/null); f=\"$r/.claude/hooks/freno.sh\"; fi; if [ ! -f \"$f\" ]; then echo 'FRENO: no encuentro .claude/hooks/freno.sh; bloqueo por seguridad (falla cerrado).' >&2; exit 2; fi; bash \"$f\"; c=$?; [ \"$c\" -eq 0 ] && exit 0; exit 2",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "GRAPHIFY_DIR=\"$CLAUDE_PROJECT_DIR/web\" bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/graphify-precontext.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-skill-flag.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run verify)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm ci)",
      "Bash(npx vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(graphify:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel env:*)",
      "Bash(vercel promote:*)",
      "Bash(vercel rollback:*)",
      "Bash(vercel redeploy:*)",
      "Bash(vercel link:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase link:*)",
      "Bash(psql:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Read(//Users/pipoandre/.openmausbot/**)",
      "Read(//Users/pipoandre/.mcp-auth/**)",
      "Read(//Users/pipoandre/.claude.json)"
    ]
  }
}
