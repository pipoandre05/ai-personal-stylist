{
  "name": "ai-personal-stylist",
  "private": true,
  "workspaces": ["web", "packages/*"],
  "engines": { "node": ">=24.3" },
  "overrides": { "react": "19.3.0", "react-dom": "19.3.0" },
  "scripts": {
    "verify": "npm run check:react && npm run verify --workspaces --if-present",
    "verify:web": "npm run verify -w web",
